# Denario proxy + app example configuration (do not commit real secrets)

# --- API Keys (set only the ones you use) ---
OPENAI_API_KEY=sk-...redacted...
# ANTHROPIC_API_KEY=sk-...redacted...
# GOOGLE_API_KEY=...redacted...
# PPLX_API_KEY=...redacted...

# --- App / Ports ---
# Streamlit UI port
PORT=7860
# Proxy bind
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# --- Proxy Budgets / Concurrency ---
# Leave some headroom below your org limits
RPM_BUDGET=60
TPM_BUDGET=190000
MAX_CONCURRENCY=1
CACHE_TTL_SECONDS=60

# --- Proxy Model Overrides ---
# Force every request to a single target (overrides aliases)
# FORCE_MODEL=gpt-5-mini

# Exact-name aliases (JSON or comma pairs). Example:
# MODEL_ALIASES={"gpt-4.1":"gpt-5-mini"}
# MODEL_ALIASES=gpt-4.1=gpt-5-mini

# Prefix aliases: remap families without changing the app code.
# Longest-prefix match wins.
# Examples:
# - Accept experimental names by mapping them to a known upstream model:
#     MODEL_ALIAS_PREFIXES=gpt-5=gpt-4o-mini   # so 'gpt-5-mini' → 'gpt-4o-mini'
# - Remap families explicitly:
#     MODEL_ALIAS_PREFIXES=gpt-4=gpt-4o-mini,o3=gpt-4o-mini
