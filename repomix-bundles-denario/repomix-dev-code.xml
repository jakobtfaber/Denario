 1: from __future__ import annotations
 2: import os
 3: import shlex
 4: import subprocess
 5: from typing import Optional
 6: def _require_env(name: str) -> str:
 7:     value = os.environ.get(name, "").strip()
 8:     if not value:
 9:         raise RuntimeError(f"Environment variable {name} must be set")
10:     return value
11: def run(
12:     expr: str,
13:     mode: str = "plaintext",
14:     timeout_seconds: Optional[int] = 120,
15: ) -> str:
16:     image = _require_env("MAPLE_IMAGE")
17:     license_file = _require_env("MAPLE_LICENSE_FILE")
18:     mac_addr = _require_env("MAPLE_MAC")
19:     if mode.lower() == "latex":
20:         maple_code = (
21:             "interface(prettyprint=0): print(latex(" + expr + ")); quit;"
22:         )
23:     else:
24:         maple_code = f"interface(prettyprint=0): {expr}; quit;"
25:     docker_cmd = [
26:         "docker",
27:         "run",
28:         "--rm",
29:         "--mac-address",
30:         mac_addr,
31:         "-v",
32:         f"{license_file}:/opt/maple2025/license/license.dat:ro",
33:         image,
34:         "bash",
35:         "-lc",
36:         f"echo {shlex.quote(maple_code)} | maple -q",
37:     ]
38:     try:
39:         proc = subprocess.run(
40:             docker_cmd,
41:             stdout=subprocess.PIPE,
42:             stderr=subprocess.PIPE,
43:             text=True,
44:             timeout=timeout_seconds,
45:             check=False,
46:         )
47:     except subprocess.TimeoutExpired as exc:
48:         raise RuntimeError(
49:             f"Maple docker run timed out after {timeout_seconds}s"
50:         ) from exc
51:     if proc.returncode != 0:
52:         raise RuntimeError(
53:             "Maple docker run failed\n"
54:             f"Command: {' '.join(docker_cmd)}\n"
55:             f"Exit: {proc.returncode}\nSTDERR:\n{proc.stderr}\n"
56:             f"STDOUT:\n{proc.stdout}"
57:         )
58:     return proc.stdout.strip()
