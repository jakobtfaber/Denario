12:         try:
13:             result    = json_parser3(result)
14:             reason    = result["Reason"]
15:             decision  = result["Decision"]
16:             query     = result["Query"]
17:             messages = f"{state['literature']['messages']}\nIteration {state['literature']['iteration']}\ndecision:{decision}\nreason:{reason}\n"
18:             iteration = state['literature']['iteration'] + 1
19:             break
20:         except Exception:
21:             time.sleep(2)
22:     else:
23:         raise Exception('Failed to extract json after 5 attempts')
24:     if 'not novel' in decision.lower():
25:         print('Decision made: not novel')
26:         return {"literature": {**state['literature'], "reason": reason, "messages": messages,
27:                                "decision": decision, "query": query, "iteration": iteration,
28:                                'next_agent': "literature_summary"}}
29:     elif 'novel' in decision.lower() or iteration>=state['literature']['max_iterations']:
30:         decision = 'novel'
31:         print('Decision made: novel')
32:         return {"literature": {**state['literature'], "reason": reason, "messages": messages,
33:                                "decision": decision, "query": query, "iteration": iteration,
34:                                'next_agent': "literature_summary"}}
35:     else:
36:         print('Decision made: query')
37:         print(f'Query: {query}')
38:         return {"literature": {**state['literature'], "reason": reason, "messages": messages,
39:                                "decision": decision, "query": query, "iteration": iteration,
40:                                'next_agent': "semantic_scholar"}}
41: def semantic_scholar(state: GraphState, config: RunnableConfig):
42:     results = SSAPI(state['literature']['query'], state['keys'], limit=10)
43:     total_papers = results.get("total", [])
44:     token        = results.get("token", [])
45:     papers       = results.get("data",  [])
46:     papers_str = []
47:     if papers:
48:         print(f"Found {total_papers} potentially relevant papers")
49:         for idx, paper in enumerate(papers, start=0):
50:             authors = ", ".join([author.get("name", "Unknown") for author in paper.get("authors", [])])
51:             title    = paper.get("title",    "No Title")
52:             year     = paper.get("year",     "Unknown Year")
53:             abstract = paper.get("abstract", "No Abstract")
54:             url      = paper.get("url",      "No URL")
55:             paper_str = f"""{idx+state['literature']['num_papers']}. {title} ({year})\nAuthors: {authors}\nAbstract: {abstract}\nURL: {url}\n\n"""
56:             with open(f"{state['files']['literature_log']}", 'a') as f:
57:                 f.write(paper_str)
58:             with open(f"{state['files']['papers']}", 'a') as f:
59:                 f.write(paper_str)
60:             paper_str = papers_str.append(f"""{idx+state['literature']['num_papers']}. {title} \nAbstract: {abstract}\nURL: {url}\n""")
61:     else:
62:         papers_str.append("No papers found with the query.\n")
63:     total_papers_found = state['literature']['num_papers'] + min(len(papers), 10)
64:     print('Total papers analyzed', total_papers_found)
65:     return {"literature": {**state['literature'], 'papers': papers_str, "num_papers":total_papers_found}}
66: def SSAPI(query, keys, limit=10):
67:     BASE_URL = "https://api.semanticscholar.org/graph/v1/paper/search"
68:     params = {"query": query,
69:               "limit": limit,
70:               "fields": "title,authors,year,abstract,url"}
71:     for _ in tqdm(range(200), desc="Calling Semantic Scholar", unit="try"):
72:         response = requests.get(BASE_URL, params=params)
73:         if response.status_code==200:
74:             return response.json()
75:         else:
76:             time.sleep(0.5)
77:     else:
78:         print(f"Error: {response.status_code}, {response.text}")
79:         return []
