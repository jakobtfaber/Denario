395: 	   \typeout{}%
396:            \typeout{}%
397:            \typeout{*******************************************************}%
398:            \typeout{Title exceeds size limitations for running head.}%
399:            \typeout{Please supply a shorter form for the running head}
400:            \typeout{with \string\icmltitlerunning{...}\space prior to \string\begin{document}}%
