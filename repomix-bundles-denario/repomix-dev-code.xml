 71: def _extract_paragraphs_from_tex_content(tex_content: str) -> dict:
 72:     paragraph_lines = {}
 73:     lines = tex_content.splitlines(keepends=True)
 74:     for i, raw_line in enumerate(lines):
 75:         line = raw_line.strip()
 76:         if not line:
 77:             continue
 78:         if line.startswith('%'):
 79:             continue
 80:         if re.match(r'\\(begin|end|section|subsection|label|caption|ref|title|author|documentclass|usepackage|newcommand|section|subsection|subsubsection|affiliation|keywords|bibliography|centering|includegraphics)', line):
 81:             continue
 82:         if re.search(r'\\(item|enumerate)', line):
 83:             continue
 84:         if re.search(r'(figure|table|equation|align|tabular)', line):
 85:             continue
 86:         if re.match(r'^\$.*\$$', line) or re.match(r'^\\\[.*\\\]$', line):
 87:             continue
 88:         paragraph_lines[i] = raw_line
 89:     return paragraph_lines
 90: def _arxiv_url_to_bib(citations: List[str]) -> Tuple[List[str], List[str]]:
 91:     bib_keys = []
 92:     bib_strs = []
 93:     for url in citations:
 94:         try:
 95:             bib_url = re.sub(r'\b(abs|html|pdf)\b', 'bibtex', url)
 96:             response = requests.get(bib_url)
 97:             if response.status_code != 200:
 98:                 match_id = re.search(r'(\d{4}\.\d+)', url)
 99:                 if match_id:
100:                     arxiv_id = match_id.group(1)
101:                     fallback_url = f"https://arxiv.org/bibtex/{arxiv_id}"
102:                     response = requests.get(fallback_url)
103:                     if response.status_code != 200:
104:                         bib_keys.append(None)
105:                         continue
106:                 else:
107:                     bib_keys.append(None)
108:                     continue
109:             bib_str = response.text.strip()
110:             match = re.match(r'@[\w]+\{([^,]+),', bib_str)
111:             if not match:
112:                 bib_keys.append(None)
113:                 continue
114:             bib_key = match.group(1)
115:             bib_keys.append(bib_key)
116:             bib_strs.append(bib_str)
117:         except Exception:
118:             bib_keys.append(None)
119:             continue
120:     return bib_keys, bib_strs
121: def _replace_grouped_citations(content: str, bib_keys: List[str]) -> str:
122:     def extract_year(key: str) -> int:
123:         match = re.search(r'\d{4}', key)
124:         return int(match.group()) if match else float('inf')
125:     def replacer(match):
126:         numbers = re.findall(r'\[(\d+)\]', match.group())
127:         keys = [bib_keys[int(n) - 1] for n in numbers if bib_keys[int(n) - 1] is not None]
128:         if not keys:
129:             return ""
130:         sorted_keys = sorted(keys, key=extract_year)
131:         return f" \\citep{{{','.join(sorted_keys)}}}"
132:     pattern = r'(?:\[\d+\])+'
133:     return re.sub(pattern, replacer, content)
134: def _replace_references_with_cite(content: str, citations: List[str], bibtex_file_str: str) -> Tuple[str, str]:
135:     bib_keys, bib_strs = _arxiv_url_to_bib(citations)
136:     content = _replace_grouped_citations(content, bib_keys)
137:     bibtex_file_str = bibtex_file_str.rstrip() + '\n\n' + '\n\n'.join(bib_strs)
138:     return content, bibtex_file_str
