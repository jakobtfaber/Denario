10: def build_lg_graph(mermaid_diagram=False):
11:     builder = StateGraph(GraphState)
12:     builder.add_node("preprocess_node",    preprocess_node)
13:     builder.add_node("maker",              idea_maker)
14:     builder.add_node("hater",              idea_hater)
15:     builder.add_node("methods",            methods_fast)
16:     builder.add_node("novelty",            novelty_decider)
17:     builder.add_node("semantic_scholar",   semantic_scholar)
18:     builder.add_node("literature_summary", literature_summary)
19:     builder.add_node("referee",            referee_fast)
20:     builder.add_edge(START,                          "preprocess_node")
21:     builder.add_conditional_edges("preprocess_node", task_router)
22:     builder.add_conditional_edges("maker",           router)
23:     builder.add_edge("hater",                        "maker")
24:     builder.add_edge("methods",                      END)
25:     builder.add_conditional_edges("novelty",         literature_router)
26:     builder.add_edge("semantic_scholar",             "novelty")
27:     builder.add_edge("literature_summary",           END)
28:     builder.add_edge("referee",                      END)
29:     memory = MemorySaver()
30:     graph  = builder.compile(checkpointer=memory)
31:     if mermaid_diagram:
32:         try:
33:             import requests
34:             original_post = requests.post
35:             def patched_post(*args, **kwargs):
36:                 kwargs.setdefault("timeout", 30)
37:                 return original_post(*args, **kwargs)
38:             requests.post = patched_post
39:             graph_image = graph.get_graph(xray=True).draw_mermaid_png()
40:             with open("graph_diagram.png", "wb") as f:
