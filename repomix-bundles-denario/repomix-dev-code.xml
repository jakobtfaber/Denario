232:             complexity = "medium"
233:         domain = "general"
234:         if any(
235:             keyword in query_lower for keyword in [
236:                 'signal',
237:                 'fft',
238:                 'filter',
239:                 'spectrum']):
240:             domain = "signal_processing"
241:         elif any(keyword in query_lower for keyword in ['statistics', 'mean', 'variance', 'correlation']):
242:             domain = "statistics"
243:         elif any(keyword in query_lower for keyword in ['optimize', 'minimize', 'maximize']):
244:             domain = "optimization"
245:         elif any(keyword in query_lower for keyword in ['matrix', 'eigen', 'linear']):
246:             domain = "linear_algebra"
247:         elif any(keyword in query_lower for keyword in ['convert', 'miles', 'kilometers', 'temperature', 'units']):
248:             domain = "unit_conversion"
249:         elif any(keyword in query_lower for keyword in ['weather', 'current', 'today', 'temperature']):
250:             domain = "real_time_data"
251:         elif any(keyword in query_lower for keyword in ['knowledge', 'what is', 'define', 'population', 'capital']):
252:             domain = "knowledge_queries"
253:         required_capabilities = []
254:         if any(
255:             keyword in query_lower for keyword in [
256:                 'plot',
257:                 'graph',
258:                 'visualize']):
259:             required_capabilities.append('visualization')
260:         if any(
261:             keyword in query_lower for keyword in [
262:                 'symbolic',
263:                 'algebraic']):
264:             required_capabilities.append('symbolic')
265:         if any(
266:             keyword in query_lower for keyword in [
267:                 'numeric',
268:                 'calculate',
269:                 'compute']):
270:             required_capabilities.append('numeric')
271:         estimated_cost = 0.0
272:         if 'wolfram_alpha' in self.providers:
273:             estimated_cost += 0.01
274:         return QueryAnalysis(
275:             complexity=complexity,
276:             domain=domain,
277:             required_capabilities=required_capabilities,
278:             estimated_cost=estimated_cost
279:         )
280:     def _select_optimal_provider(self,
281:                                  query_analysis: QueryAnalysis,
282:                                  context: Dict[str,
283:                                                Any] = None) -> str:
284:         if query_analysis.domain in self.domain_routing:
285:             preferred_provider = self.domain_routing[query_analysis.domain]
286:             if preferred_provider in self.providers:
287:                 return preferred_provider
288:         provider_scores = {}
289:         for provider_name, provider in self.providers.items():
290:             if provider_name not in self.capability_matrix:
291:                 continue
292:             capabilities = self.capability_matrix[provider_name]
293:             score = 0
294:             for capability in query_analysis.required_capabilities:
295:                 if capability in capabilities:
296:                     score += capabilities[capability]
297:             if query_analysis.complexity == "high" and capabilities.get(
298:                     'numeric', 0) >= 9:
299:                 score += 2
300:             elif query_analysis.complexity == "medium" and capabilities.get('numeric', 0) >= 7:
301:                 score += 1
302:             provider_scores[provider_name] = score
303:         if not provider_scores:
304:             raise ComputationError("No suitable providers available")
305:         return max(provider_scores.items(), key=lambda x: x[1])[0]
