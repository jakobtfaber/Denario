759: % NUMBER with left flushed zeros  \fillzeros[<WIDTH>]<NUMBER>
760: \newcount\cv@tmpc@ \newcount\cv@tmpc
761: \def\fillzeros[#1]#2{\cv@tmpc@=#2\relax\ifnum\cv@tmpc@<0\cv@tmpc@=-\cv@tmpc@\fi
762: \cv@tmpc=1 %
763: \loop\ifnum\cv@tmpc@<10 \else \divide\cv@tmpc@ by 10 \advance\cv@tmpc by 1 \fi
764:    \ifnum\cv@tmpc@=10\relax\cv@tmpc@=11\relax\fi \ifnum\cv@tmpc@>10 \repeat
765: \ifnum#2<0\advance\cv@tmpc1\relax-\fi
766: \loop\ifnum\cv@tmpc<#1\relax0\advance\cv@tmpc1\relax\fi \ifnum\cv@tmpc<#1 \repeat
767: \cv@tmpc@=#2\relax\ifnum\cv@tmpc@<0\cv@tmpc@=-\cv@tmpc@\fi \relax\the\cv@tmpc@}%
768: % \makevruler[<SCALE>][<INITIAL_COUNT>][<STEP>][<DIGITS>][<HEIGHT>]
769: \def\makevruler[#1][#2][#3][#4][#5]{
770: 	\begingroup\offinterlineskip
771: 		\textheight=#5\vbadness=10000\vfuzz=120ex\overfullrule=0pt%
772: 		\global\setbox\icmlrulerbox=\vbox to \textheight{%
773: 			{
774: 				\parskip=0pt\hfuzz=150em\cv@boxheight=\textheight
775: 				\cv@lineheight=#1\global\icmlrulercount=#2%
776: 				\cv@tot\cv@boxheight\divide\cv@tot\cv@lineheight\advance\cv@tot2%
777: 				\cv@refno1\vskip-\cv@lineheight\vskip1ex%
778: 				\loop\setbox\cv@tmpbox=\hbox to0cm{					 % side margin
779: 					\hfil {\hfil\fillzeros[#4]\icmlrulercount}
780: 				}%
781: 				\ht\cv@tmpbox\cv@lineheight\dp\cv@tmpbox0pt\box\cv@tmpbox\break
782: 				\advance\cv@refno1\global\advance\icmlrulercount#3\relax
783: 				\ifnum\cv@refno<\cv@tot\repeat
784: 			}
785: 		}
786: 	\endgroup
787: }%
788: \makeatother
