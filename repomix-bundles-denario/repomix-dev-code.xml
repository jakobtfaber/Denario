 1: from typing import Dict, Any, Optional
 2: from langchain_core.tools import BaseTool
 3: from pydantic import BaseModel, Field
 4: from ..utils import WolframAlphaClient
 5: class WolframAlphaInput(BaseModel):
 6:     query: str = Field(
 7:         description="Mathematical query, equation, or computation to perform")
 8:     use_cache: bool = Field(
 9:         default=True,
10:         description="Whether to use cached results")
11:     require_hitl: bool = Field(
12:         default=False,
13:         description="Whether to require human review for ambiguous results")
14: class WolframAlphaTool(BaseTool):
15:     name: str = "wolfram_compute"
16:     description: str = (
17:         "Perform mathematical computations, symbolic reasoning, unit conversions, "
18:         "and equation solving using Wolfram Alpha. Use for: integrals, derivatives, "
19:         "algebraic manipulation, unit conversions, physical constants, and exact solutions.")
20:     args_schema: type[BaseModel] = WolframAlphaInput
21:     def __init__(
22:             self,
23:             app_id: Optional[str] = None,
24:             enable_hitl: bool = False,
25:             **kwargs):
26:         super().__init__(**kwargs)
27:         self._client = WolframAlphaClient(
28:             app_id=app_id, enable_hitl=enable_hitl)
29:     def _run(
30:             self,
31:             query: str,
32:             use_cache: bool = True,
33:             require_hitl: bool = False) -> str:
34:         try:
35:             result = self._client.query(query, use_cache=use_cache)
36:             if not result.get("queryresult", {}).get("success"):
37:                 error_msg = result.get(
38:                     "queryresult", {}).get(
39:                     "error", "Unknown error")
40:                 return f"Wolfram Alpha query failed: {error_msg}"
41:             if (require_hitl or self._client.enable_hitl) and self._client.needs_hitl_review(
42:                     result):
43:                 hitl_prompt = self._client.get_hitl_prompt(query, result)
44:                 return f"HITL_REVIEW_NEEDED: {hitl_prompt}"
45:             structured = WolframAlphaClient.extract_structured_results(result)
46:             primary_text = WolframAlphaClient.extract_primary_text(result)
47:             response_parts = []
48:             if primary_text:
49:                 response_parts.append(f"Result: {primary_text}")
50:             if structured["latex"]:
51:                 response_parts.append(f"LaTeX: {structured['latex'][0]}")
52:             if structured["assumptions"]:
53:                 response_parts.append(
54:                     f"Assumptions: {', '.join(structured['assumptions'][:2])}")
55:             if structured["sources"]:
56:                 response_parts.append(
57:                     f"Sources: {', '.join(structured['sources'][:2])}")
58:             return "\n".join(
59:                 response_parts) if response_parts else "No results found"
60:         except Exception as e:
61:             return f"Wolfram Alpha tool error: {str(e)}"
62:     async def _arun(
63:             self,
64:             query: str,
65:             use_cache: bool = True,
66:             require_hitl: bool = False) -> str:
67:         return self._run(query, use_cache, require_hitl)
68: def create_wolfram_tool(
69:         app_id: Optional[str] = None,
70:         enable_hitl: bool = False) -> WolframAlphaTool:
71:     return WolframAlphaTool(app_id=app_id, enable_hitl=enable_hitl)
72: def get_wolfram_tools() -> list[WolframAlphaTool]:
73:     return [
74:         create_wolfram_tool(enable_hitl=False),
75:         create_wolfram_tool(enable_hitl=True),
76:     ]
