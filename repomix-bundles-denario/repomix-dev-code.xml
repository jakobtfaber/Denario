 25:     def __init__(self, app_id: str | None = None, timeout_s: int = 20,
 26:                  cache_dir: str | None = None, enable_hitl: bool = False):
 27:         import requests
 28:         import hashlib
 29:         import json
 30:         from pathlib import Path
 31:         self._requests = requests
 32:         self._hashlib = hashlib
 33:         self._json = json
 34:         self._Path = Path
 35:         self.app_id = app_id or os.getenv("WOLFRAM_APP_ID")
 36:         self.timeout_s = timeout_s
 37:         self.enable_hitl = enable_hitl
 38:         if not self.app_id:
 39:             raise RuntimeError("WOLFRAM_APP_ID not configured")
 40:         self.cache_dir = Path(
 41:             cache_dir or os.path.join(
 42:                 os.getcwd(), ".wolfram_cache"))
 43:         self.cache_dir.mkdir(exist_ok=True)
 44:     def _get_cache_key(self, query: str) -> str:
 45:         normalized = query.strip().lower()
 46:         return self._hashlib.md5(normalized.encode()).hexdigest()
 47:     def _load_from_cache(self, cache_key: str) -> Dict | None:
 48:         cache_file = self.cache_dir / f"{cache_key}.json"
 49:         if cache_file.exists():
 50:             try:
 51:                 with open(cache_file, 'r') as f:
 52:                     return self._json.load(f)
 53:             except Exception:
 54:                 return None
 55:         return None
 56:     def _save_to_cache(self, cache_key: str, result: Dict) -> None:
 57:         cache_file = self.cache_dir / f"{cache_key}.json"
 58:         try:
 59:             with open(cache_file, 'w') as f:
 60:                 self._json.dump(result, f, indent=2)
 61:         except Exception:
 62:             pass
 63:     def query(self, q: str, use_cache: bool = True) -> Dict:
 64:         cache_key = self._get_cache_key(q)
 65:         # Try cache first
 66:         if use_cache:
 67:             cached = self._load_from_cache(cache_key)
 68:             if cached:
 69:                 return cached
 70:         # Make API call
 71:         url = "https://api.wolframalpha.com/v2/query"
 72:         params = {
 73:             "input": q,
 74:             "appid": self.app_id,
 75:             "output": "JSON",
 76:             "format": "plaintext,mathml,image",
 77:         }
 78:         try:
 79:             resp = self._requests.get(
 80:                 url, params=params, timeout=self.timeout_s)
 81:             resp.raise_for_status()
 82:             result = resp.json()
 83:             # Cache successful results
 84:             if result.get("queryresult", {}).get("success"):
 85:                 self._save_to_cache(cache_key, result)
 86:             return result
 87:         except Exception as e:
 88:             raise RuntimeError(f"Wolfram Alpha query failed: {e}")
 89:     @staticmethod
 90:     def extract_primary_text(wa_json: Dict) -> str | None:
