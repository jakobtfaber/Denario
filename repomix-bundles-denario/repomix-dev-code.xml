221:     def _analyze_query(self, query: str) -> QueryAnalysis:
222:         query_lower = query.lower()
223:         complexity = "low"
224:         if any(
225:             keyword in query_lower for keyword in [
226:                 'integrate',
227:                 'solve',
228:                 'optimize',
