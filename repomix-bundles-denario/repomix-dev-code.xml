 1: from langgraph.graph import START, StateGraph, END
 2: from langgraph.checkpoint.memory import MemorySaver
 3: from .parameters import GraphState
 4: from .paper_node import abstract_node, citations_node, conclusions_node, introduction_node, keywords_node, methods_node, plots_node, refine_results, results_node
 5: from .reader import preprocess_node
 6: from .routers import citation_router
 7: def build_graph(mermaid_diagram=False):
 8:     builder = StateGraph(GraphState)
 9:     builder.add_node("preprocess_node",   preprocess_node)
10:     builder.add_node("abstract_node",     abstract_node)
11:     builder.add_node("introduction_node", introduction_node)
12:     builder.add_node("methods_node",      methods_node)
13:     builder.add_node("results_node",      results_node)
14:     builder.add_node("conclusions_node",  conclusions_node)
15:     builder.add_node("plots_node",        plots_node)
16:     builder.add_node("refine_results",    refine_results)
17:     builder.add_node("keywords_node",     keywords_node)
18:     builder.add_node("citations_node",    citations_node)
19:     builder.add_edge(START,                         "preprocess_node")
20:     builder.add_edge("preprocess_node",             "keywords_node")
21:     builder.add_edge("keywords_node",               "abstract_node")
22:     builder.add_edge("abstract_node",               "introduction_node")
23:     builder.add_edge("introduction_node",           "methods_node")
24:     builder.add_edge("methods_node",                "results_node")
25:     builder.add_edge("results_node",                "conclusions_node")
26:     builder.add_edge("conclusions_node",            "plots_node")
27:     builder.add_edge("plots_node",                  "refine_results")
28:     builder.add_conditional_edges("refine_results", citation_router)
29:     builder.add_edge("citations_node",              END)
30:     memory = MemorySaver()
31:     graph  = builder.compile(checkpointer=memory)
32:     if mermaid_diagram:
33:         try:
34:             import requests
35:             original_post = requests.post
36:             def patched_post(*args, **kwargs):
37:                 kwargs.setdefault("timeout", 30)
38:                 return original_post(*args, **kwargs)
39:             requests.post = patched_post
40:             graph_image = graph.get_graph(xray=True).draw_mermaid_png()
41:             with open("graph_diagram.png", "wb") as f:
42:                 f.write(graph_image)
43:             print("✅ Graph diagram saved to graph_diagram.png")
44:         except Exception as e:
45:             print(f"⚠️ Failed to generate or save graph diagram: {e}")
46:     return graph
