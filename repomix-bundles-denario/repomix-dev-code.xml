 3: from dataclasses import dataclass
 4: from datetime import datetime
 5: @dataclass
 6: class ComputationResult:
 7:     plaintext: str
 8:     latex: Optional[str] = None
 9:     mathml: Optional[str] = None
10:     images: List[str] = None
11:     assumptions: List[str] = None
12:     sources: List[str] = None
13:     provider: str = "unknown"
14:     cost: float = 0.0
15:     execution_time: float = 0.0
16:     error: Optional[str] = None
17:     query: Optional[str] = None
18:     def __post_init__(self):
19:         if self.images is None:
20:             self.images = []
21:         if self.assumptions is None:
22:             self.assumptions = []
23:         if self.sources is None:
24:             self.sources = []
25: class ComputationError(Exception):
26:     pass
27: class MathematicalProvider(ABC):
28:     def __init__(self,
29:                  capabilities: List[str] = None,
30:                  cost_per_query: float = 0.0,
31:                  max_complexity: str = "medium",
32:                  priority: int = 1,
33:                  **kwargs):
34:         self.capabilities = capabilities or []
35:         self.cost_per_query = cost_per_query
36:         self.max_complexity = max_complexity
37:         self.priority = priority
38:         self._execution_times = []
39:         self._total_cost = 0.0
40:     @abstractmethod
41:     def compute(self, query: str) -> ComputationResult:
42:         pass
43:     def can_handle(
44:             self,
45:             query: str,
46:             required_capabilities: List[str] = None) -> bool:
47:         if required_capabilities:
48:             return all(
49:                 cap in self.capabilities for cap in required_capabilities)
50:         return True
51:     def estimate_cost(self, query: str) -> float:
52:         return self.cost_per_query
53:     def get_performance_stats(self) -> Dict[str, Any]:
54:         if not self._execution_times:
55:             return {
56:                 'avg_execution_time': 0.0,
57:                 'total_queries': 0,
58:                 'total_cost': self._total_cost
59:             }
60:         return {
61:             'avg_execution_time': sum(self._execution_times) / len(self._execution_times),
62:             'min_execution_time': min(self._execution_times),
63:             'max_execution_time': max(self._execution_times),
64:             'total_queries': len(self._execution_times),
65:             'total_cost': self._total_cost
66:         }
67:     def _record_execution(self, execution_time: float, cost: float = None):
68:         self._execution_times.append(execution_time)
69:         if cost is not None:
