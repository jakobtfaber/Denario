 1: from langchain_core.runnables import RunnableConfig
 2: from langchain_core.messages import HumanMessage
 3: from ..paper_agents.tools import extract_latex_block, LLM_call_stream, clean_section
 4: from ..tools import create_wolfram_tool
 5: from .prompts import methods_fast_prompt
 6: from .parameters import GraphState
 7: def methods_fast(state: GraphState, config: RunnableConfig):
 8:     print('Generating methods...', end="", flush=True)
 9:     wolfram_tool = create_wolfram_tool(enable_hitl=False)
10:     llm = state['llm']['llm']
11:     llm_with_tools = llm.bind_tools([wolfram_tool])
12:     PROMPT = methods_fast_prompt(state)
13:     state, result = LLM_call_stream_with_tools(PROMPT, state, llm_with_tools)
14:     text = extract_latex_block(state, result, "METHODS")
15:     text = clean_section(text, "METHODS")
16:     with open(state['files']['methods'], 'w') as f:
17:         f.write(text)
18:     print(f"done {state['tokens']['ti']} {state['tokens']['to']}")
19: def LLM_call_stream_with_tools(prompt, state, llm_with_tools):
20:     output_file_path = state['files']['f_stream']
21:     full_content = ''
22:     state['tokens']['i'] = 0
23:     state['tokens']['o'] = 0
24:     with open(output_file_path, 'a') as f:
25:         for chunk in llm_with_tools.stream(prompt):
26:             text = chunk.content
27:             f.write(text)
28:             f.flush()
29:             if state['llm']['stream_verbose']:
30:                 print(text, end='', flush=True)
31:             full_content += text
32:             usage = chunk.usage_metadata if hasattr(
33:                 chunk, 'usage_metadata') else None
34:             if usage:
35:                 input_tokens = usage.get('input_tokens', 0)
36:                 output_tokens = usage.get('output_tokens', 0)
37:                 if output_tokens > state['llm']['max_output_tokens']:
38:                     print('WARNING!! Max output tokens reached!')
39:                 state['tokens']['ti'] += input_tokens
40:                 state['tokens']['to'] += output_tokens
41:                 state['tokens']['i'] += input_tokens
42:                 state['tokens']['o'] += output_tokens
43:         f.write('\n\n')
44:     with open(state['files']['LLM_calls'], 'a') as f:
45:         f.write(
46:             f"{
47:                 state['tokens']['i']} {
48:                 state['tokens']['o']} {
49:                 state['tokens']['ti']} {
50:                     state['tokens']['to']}\n")
51:     return state, full_content
