 95: def json_parser(text):
 96:     json_pattern = r"```json(.*)```"
 97:     match = re.findall(json_pattern, text, re.DOTALL)
 98:     if not match:
 99:         raise ValueError("No JSON fenced block found in text")
100:     json_string = match[0].strip()
101:     json_string = json_string.replace("\\", "\\\\")
102:     try:
103:         parsed_json = json.loads(json_string)
104:     except json.decoder.JSONDecodeError:
105:         try:
106:             json_string = json_string.replace("'", "\"")
107:             parsed_json = json.loads(json_string)
108:         except Exception as e:
109:             raise ValueError(f"Failed to parse JSON: {e}")
110:     return parsed_json
