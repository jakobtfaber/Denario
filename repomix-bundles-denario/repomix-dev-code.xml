 1: from langchain_core.runnables import RunnableConfig
 2: from ..paper_agents.tools import extract_latex_block, LLM_call_stream, clean_section
 3: from .prompts import reviewer_fast_prompt
 4: from .parameters import GraphState
 5: from .pdf_reader import pdf_to_images
 6: def referee_fast(state: GraphState, config: RunnableConfig):
 7:     print('Reviewing the paper...', end="", flush=True)
 8:     if state['referee']['paper_version']==2:
 9:         paper_name = "paper_v2_no_citations.pdf"
10:     elif state['referee']['paper_version']==4:
11:         paper_name = "paper_v4_final.pdf"
12:     pdf_path = f"{state['files']['Paper_folder']}/{paper_name}"
13:     out_dir = f"{state['files']['paper_images']}"
14:     state['referee']['images'] = pdf_to_images(pdf_path, out_dir)
15:     PROMPT = reviewer_fast_prompt(state)
16:     state, result = LLM_call_stream(PROMPT, state)
17:     text = extract_latex_block(state, result, "REVIEW")
18:     text = clean_section(text, "REVIEW")
19:     with open(state['files']['referee_report'], 'w') as f:
20:         f.write(text)
21:     print(f"done {state['tokens']['ti']} {state['tokens']['to']}")
