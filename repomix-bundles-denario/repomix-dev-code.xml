 97:                         pt = sp.get("plaintext")
 98:                         if pt:
 99:                             return pt
100:             for pod in pods:
101:                 for sp in pod.get("subpods", []):
102:                     pt = sp.get("plaintext")
103:                     if pt:
104:                         return pt
105:         except Exception:
106:             return None
107:         return None
108:     @staticmethod
109:     def extract_structured_results(wa_json: Dict) -> Dict:
110:         result = {
111:             "plaintext": [],
112:             "latex": [],
113:             "mathml": [],
114:             "images": [],
115:             "assumptions": [],
116:             "sources": []
117:         }
118:         try:
119:             pods = wa_json["queryresult"].get("pods", [])
120:             for pod in pods:
121:                 # Extract assumptions
122:                 if "assumptions" in pod:
123:                     result["assumptions"].extend(pod["assumptions"])
124:                 # Extract sources
125:                 if "sources" in pod:
126:                     result["sources"].extend(pod["sources"])
127:                 # Extract subpod content
128:                 for subpod in pod.get("subpods", []):
129:                     if "plaintext" in subpod:
130:                         result["plaintext"].append(subpod["plaintext"])
131:                     if "mathml" in subpod:
132:                         result["mathml"].append(subpod["mathml"])
133:                     if "latex" in subpod:
134:                         result["latex"].append(subpod["latex"])
135:                     if "img" in subpod:
136:                         result["images"].append(subpod["img"])
137:         except Exception:
138:             pass
139:         return result
140:     def needs_hitl_review(self, wa_json: Dict) -> bool:
141:         if not self.enable_hitl:
142:             return False
143:         try:
144:             # Check for ambiguous results
145:             pods = wa_json["queryresult"].get("pods", [])
146:             for pod in pods:
147:                 # Multiple interpretations
148:                 if len(pod.get("subpods", [])) > 3:
149:                     return True
150:                 # Assumptions that might need review
151:                 if pod.get("assumptions"):
152:                     return True
153:                 # Error or warning states
154:                 if pod.get("error") or pod.get("warning"):
155:                     return True
156:         except Exception:
157:             pass
158:         return False
159:     def get_hitl_prompt(self, query: str, wa_json: Dict) -> str:
160:         structured = self.extract_structured_results(wa_json)
161:         prompt = f"""Wolfram Alpha returned ambiguous results for query: "{query}"
162: Results:
163: - Plaintext: {structured['plaintext'][:3]}
164: - Assumptions: {structured['assumptions'][:2]}
165: - Sources: {structured['sources'][:2]}
166: Please review and select the most appropriate result, or provide clarification."""
167:         return prompt
