334:             if compile_tex_document(state, f_temp, state['files']['Temp']):
335:                 break
336:             else:
337:                 state['latex']['section_to_fix'] = "Results"
338:                 state, fixed = fix_latex(state, f_temp)
339:                 if fixed:
340:                     break
341:     minutes, seconds = divmod(time.time() - state['time']['start'], 60)
342:     print(
343:         f" |  done {
344:             state['tokens']['ti']} {
345:             state['tokens']['to']} [{
346:                 int(minutes)}m {
347:                     int(seconds)}s]")
348:     save_paper(state, state['files']['Paper_v2'])
349:     compile_latex(state, state['files']['Paper_v2'])
350:     return {'paper': {**state['paper'], 'Results': state['paper']['Results']},
351:             'tokens': state['tokens']}
352: def check_references(state: GraphState, text: str) -> str:
353:     PROMPT = references_prompt(state, text)
354:     state, result = LLM_call(PROMPT, state)
355:     section_text = extract_latex_block(state, result, "Text")
356:     return section_text
357: async def add_citations_async(state, text, section_name):
358:     f_temp1 = Path(f"{state['files']['Temp']}/{section_name}_w_citations.tex")
359:     f_temp2 = Path(f"{state['files']['Temp']}/{section_name}.bib")
360:     if f_temp1.exists():
361:         new_text = temp_file(state, f_temp1, 'read')
362:         references = temp_file(state, f_temp2, 'read')
363:     else:
364:         loop = asyncio.get_event_loop()
365:         func = partial(process_tex_file_with_references, text, state["keys"])
366:         new_text, references = await loop.run_in_executor(None, func)
367:         new_text = clean_section(new_text, section_name)
368:         temp_file(state, f_temp2, 'write', references)
369:         temp_file(state, f_temp1, 'write', new_text)
370:     print(f'    {section_name} done')
371:     return section_name, new_text, references
372: async def citations_node(state: GraphState, config: RunnableConfig):
373:     print("Adding citations...")
374:     sections = ['Introduction', 'Methods']
375:     tasks = [
376:         add_citations_async(
377:             state,
378:             state['paper'][section],
379:             section) for section in sections]
380:     results = await asyncio.gather(*tasks)
381:     bib_entries_set = set()
382:     bib_entries_list = []
383:     for section_name, updated_text, references in results:
384:         state['paper'][section_name] = updated_text
385:         entries = references.strip().split('\n\n')
386:         for entry in entries:
387:             clean_entry = entry.strip()
388:             if clean_entry and clean_entry not in bib_entries_set:
389:                 bib_entries_list.append(clean_entry)
390:     state['paper']['References'] = "\n\n".join(bib_entries_list)
391:     save_paper(state, state['files']['Paper_v3'])
392:     save_bib(state)
393:     process_bib_file(f"{state['files']['Paper_folder']}/bibliography_temp.bib",
394:                      f"{state['files']['Paper_folder']}/bibliography.bib")
395:     print("✅ Citations added to all sections.")
396:     compile_latex(state, state['files']['Paper_v3'])
397:     print("Making a final check to the sections...")
398:     for section_name in sections:
399:         f_temp = Path(
400:             f"{state['files']['Temp']}/{section_name}_w_citations2.tex")
401:         if f_temp.exists():
402:             section_text = temp_file(state, f_temp, 'read')
403:         else:
404:             PROMPT = clean_section_prompt(state, state['paper'][section_name])
405:             state, result = LLM_call(PROMPT, state)
406:             section_text = extract_latex_block(state, result, "Text")
407:             section_text = LaTeX_checker(state, section_text)
408:             section_text = clean_section(
409:                 section_text, section_name)
410:             temp_file(state, f_temp, 'write', section_text)
411:         state['paper'][section_name] = section_text
412:     save_paper(state, state['files']['Paper_v4'])
413:     compile_latex(state, state['files']['Paper_v4'])
414:     return {'paper': state['paper'],
415:             'tokens': state['tokens']}
