 21: def extract_latex_errors(state):
 22:     with open(state['files']['LaTeX_log'], 'r') as f:
 23:         lines = f.readlines()
 24:     errors = []
 25:     i = 0
 26:     while i < len(lines):
 27:         line = lines[i].strip()
 28:         if line.startswith("! "):
 29:             error_block = [line]
 30:             i += 1
 31:             while i < len(lines):
 32:                 next_line = lines[i].strip()
 33:                 if (
 34:                     next_line.startswith("! ") or
 35:                     next_line.startswith("(/") or
 36:                     next_line.startswith(")") or
 37:                     next_line.startswith("Package ") or
 38:                     next_line.startswith("Document Class") or
 39:                     next_line.startswith("(/usr") or
 40:                     re.match(r'^\([^\)]+\.sty', next_line) or
 41:                     re.match(r'^\(/', next_line) or
 42:                     re.match(r'^.*\.tex$', next_line)
 43:                 ):
 44:                     break
 45:                 error_block.append(next_line)
 46:                 i += 1
 47:             errors.append("\n".join(error_block))
 48:         else:
 49:             i += 1
