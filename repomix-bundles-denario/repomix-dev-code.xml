272:     def _parse_query_to_matlab_function(self, query: str):
273:         query_lower = query.lower()
274:         if 'solve' in query_lower or '=' in query_lower:
275:             # Convert to MATLAB solve syntax
276:             matlab_query = self._convert_to_matlab_solve(query)
277:             return lambda: self.engine.eval(matlab_query)
278:         elif 'integrate' in query_lower or 'int' in query_lower:
279:             # Convert to MATLAB int syntax
280:             matlab_query = self._convert_to_matlab_integral(query)
281:             return lambda: self.engine.eval(matlab_query)
282:         elif 'derivative' in query_lower or 'diff' in query_lower:
283:             # Convert to MATLAB diff syntax
284:             matlab_query = self._convert_to_matlab_diff(query)
285:             return lambda: self.engine.eval(matlab_query)
286:         elif 'eigen' in query_lower or 'eigenvalue' in query_lower:
287:             # Convert to MATLAB eig syntax
288:             matlab_query = self._convert_to_matlab_eig(query)
289:             return lambda: self.engine.eval(matlab_query)
290:         elif 'optimize' in query_lower or 'minimize' in query_lower or 'maximize' in query_lower:
291:             # Convert to MATLAB optimization syntax
292:             matlab_query = self._convert_to_matlab_optimize(query)
293:             return lambda: self.engine.eval(matlab_query)
294:         elif 'plot' in query_lower or 'graph' in query_lower:
295:             # Convert to MATLAB plot syntax
296:             matlab_query = self._convert_to_matlab_plot(query)
297:             return lambda: self.engine.eval(matlab_query)
298:         else:
299:             # Direct evaluation
300:             return lambda: self.engine.eval(query)
301:     def _convert_to_matlab_solve(self, query: str) -> str:
302:         # Simple conversion for basic equations
303:         # Example: "solve x^2 + 2*x + 1 = 0" -> "syms x; solve(x^2 + 2*x + 1 ==
304:         # 0, x)"
305:         if '=' in query:
306:             equation = query.split('solve')[1].strip()
307:             if '=' in equation:
308:                 left, right = equation.split('=', 1)
309:                 left = left.strip()
310:                 right = right.strip()
311:                 return f"syms x; solve({left} == {right}, x)"
312:         return f"syms x; solve({query}, x)"
313:     def _convert_to_matlab_integral(self, query: str) -> str:
314:         # Example: "integrate x^2 from 0 to 1" -> "syms x; int(x^2, x, 0, 1)"
315:         if 'from' in query and 'to' in query:
316:             parts = query.split()
317:             expr = parts[1]  # x^2
318:             from_idx = parts.index('from')
319:             to_idx = parts.index('to')
320:             lower = parts[from_idx + 1]
321:             upper = parts[to_idx + 1]
322:             return f"syms x; int({expr}, x, {lower}, {upper})"
323:         else:
324:             # Indefinite integral
325:             expr = query.replace('integrate', '').replace('int', '').strip()
326:             return f"syms x; int({expr}, x)"
327:     def _convert_to_matlab_diff(self, query: str) -> str:
328:         # Example: "derivative of x^3" -> "syms x; diff(x^3, x)"
329:         if 'of' in query:
330:             expr = query.split('of')[1].strip()
331:             return f"syms x; diff({expr}, x)"
332:         else:
333:             expr = query.replace('derivative', '').replace('diff', '').strip()
334:             return f"syms x; diff({expr}, x)"
335:     def _convert_to_matlab_eig(self, query: str) -> str:
336:         # Example: "eigenvalues of [1 2; 3 4]" -> "eig([1 2; 3 4])"
337:         if 'of' in query:
338:             matrix = query.split('of')[1].strip()
339:             return f"eig({matrix})"
340:         else:
341:             # Extract matrix from query
342:             import re
343:             matrix_match = re.search(r'\[.*?\]', query)
344:             if matrix_match:
345:                 matrix = matrix_match.group()
346:                 return f"eig({matrix})"
347:             return "eig([1 2; 3 4])"  # Default matrix
348:     def _convert_to_matlab_optimize(self, query: str) -> str:
349:         # Example: "optimize x^2 + 2*x + 1" -> "syms x; f = x^2 + 2*x + 1;
350:         # fminunc(@(x) x^2 + 2*x + 1, 0)"
351:         if 'optimize' in query:
352:             expr = query.replace('optimize', '').strip()
353:             return f"syms x; f = {expr}; fminunc(@(x) {expr}, 0)"
354:         return f"syms x; fminunc(@(x) {query}, 0)"
355:     def _convert_to_matlab_plot(self, query: str) -> str:
356:         # Example: "plot x^2 from -5 to 5" -> "x = -5:0.1:5; y = x.^2; plot(x,
357:         # y)"
358:         if 'from' in query and 'to' in query:
359:             parts = query.split()
360:             expr = parts[1]  # x^2
361:             from_idx = parts.index('from')
362:             to_idx = parts.index('to')
363:             lower = parts[from_idx + 1]
364:             upper = parts[to_idx + 1]
365:             return f"x = {lower}:0.1:{upper}; y = {expr}; plot(x, y)"
366:         else:
367:             expr = query.replace('plot', '').replace('graph', '').strip()
368:             return f"x = -10:0.1:10; y = {expr}; plot(x, y)"
369:     def _convert_to_latex(self, result) -> str:
370:         try:
371:             if self.engine:
372:                 # Try to get LaTeX representation
373:                 latex_result = self.engine.eval(f"latex({result})")
374:                 return str(latex_result)
375:         except BaseException:
376:             pass
377:         # Fallback: convert result to basic LaTeX
378:         result_str = str(result)
379:         if isinstance(result, (int, float)):
380:             return f"${result_str}$"
381:         elif '[' in result_str and ']' in result_str:
382:             # Matrix format
383:             return f"$\\begin{{bmatrix}} {result_str} \\end{{bmatrix}}$"
384:         else:
385:             return f"${result_str}$"
386:     def _convert_to_mathml(self, result) -> str:
387:         try:
388:             if self.engine:
389:                 # Try to get MathML representation
390:                 mathml_result = self.engine.eval(f"mathml({result})")
391:                 return str(mathml_result)
392:         except BaseException:
393:             pass
394:         # Fallback: convert result to basic MathML
395:         result_str = str(result)
396:         if isinstance(result, (int, float)):
397:             return f"<math><mn>{result_str}</mn></math>"
398:         else:
399:             return f"<math><mtext>{result_str}</mtext></math>"
400:     def _generate_visualizations(self, result, query: str) -> List[str]:
401:         images = []
402:         # Check if query involves plotting
403:         if any(keyword in query.lower()
404:                for keyword in ['plot', 'graph', 'visualize', 'show']):
405:             # Mock image generation
406:             images.append(f"matlab_plot_{hash(query) % 1000}.png")
407:         return images
408:     def analyze_data(
409:             self,
410:             data: List[float],
411:             analysis_type: str = "basic") -> ComputationResult:
412:         if self.engine is None:
413:             # Mock data analysis
414:             return self._mock_data_analysis(data, analysis_type)
415:         try:
