 47: def process_tex_file_with_references(text, keys: KeyManager, nparagraphs=None):
 48:     lines = text.splitlines()
 49:     para_dict = _extract_paragraphs_from_tex_content(text)
 50:     str_bib = ''
 51:     count = 0
 52:     for kpara in sorted(para_dict.keys()):
 53:         if count == 0:
 54:             count += 1
 55:             continue
 56:         para = para_dict[kpara]
 57:         for attempt in range(2):
 58:             new_para, citations = perplexity(para, keys)
 59:             if new_para is not None:
 60:                 break
 61:             else:
 62:                 count += 1
 63:                 continue
 64:         new_para, str_bib = _replace_references_with_cite(new_para, citations, str_bib)
 65:         lines[kpara] = new_para
